STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
DB_NAME=medusa-backend

# --- Nova Poshta (real, public API — https://developers.novaposhta.ua) ---
NOVA_POSHTA_API_KEY=
# Ref of the city/warehouse you ship FROM, required for live price calculation.
# Look it up once via GET /store/delivery/nova-poshta/cities?q=<your city>
NOVA_POSHTA_SENDER_CITY_REF=

# --- Ukrposhta (PLACEHOLDER — requires a signed API contract, see
# src/modules/ukrposhta-fulfillment/client.ts for details) ---
UKRPOSHTA_API_BASE_URL=
UKRPOSHTA_BEARER_TOKEN=
UKRPOSHTA_USER_TOKEN=
UKRPOSHTA_SENDER_CITY_REF=

# --- Plata by mono (https://api.monobank.ua/docs/acquiring.html) ---
# X-Token from https://web.monobank.ua (test token from https://api.monobank.ua/)
MONO_TOKEN=
# Optional, defaults to https://api.monobank.ua
MONO_API_BASE_URL=
# Storefront page the customer lands on after paying (never trusted as
# proof of payment, only used for UX) — see checkout/mono/return.
MONO_REDIRECT_URL=http://localhost:8000/checkout/mono/return
# Must be reachable from the public internet (mono calls it directly).
# Built from Medusa's own convention: /hooks/payment/{identifier}_{id}
# where identifier="mono" (static field on the provider class) and
# id="mono" (the `id` given to it in medusa-config.ts).
MONO_WEBHOOK_URL=https://api.yourshop.com/hooks/payment/mono_mono
# Optional, seconds, defaults to 1800 (30 min)
MONO_VALIDITY_SECONDS=
# Optional, "debit" (default, capture immediately) or "hold" (2-step)
MONO_PAYMENT_TYPE=
